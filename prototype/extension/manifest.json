{
  "manifest_version": 3,
  "name": "YouTube Watch Capture",
  "version": "1.0.0",
  "description": "Sample frames, audio, and captions from a YouTube video while you watch it, and keep one folder per video.",
  "permissions": ["tabCapture", "offscreen", "downloads", "storage"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "YouTube Watch Capture",
    "default_popup": "src/popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["src/inject/page-hook.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": [
        "src/lib/bytes.js",
        "src/lib/resume.js",
        "src/lib/sample-policy.js",
        "src/lib/transcript.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
